# ポイガチャ デモ — 環境変数（すべて任意。未設定時はデモ用の既定値で動作します）

# セッションCookieの署名鍵（本番では必ず長いランダム文字列に変更）
SESSION_SECRET=change-me-to-a-long-random-string

# 広告ネットワーク / オファーウォールの成果通知（Webhook）署名検証用シークレット
ADMOB_SSV_SECRET=demo-admob-ssv-secret
SKYFLAG_POSTBACK_SECRET=demo-skyflag-postback-secret
TAPJOY_POSTBACK_SECRET=demo-tapjoy-postback-secret

# 管理画面からアップロードできるファイルの上限（MB）。Vercel にデプロイする場合は 4 以下にしてください
MEDIA_MAX_UPLOAD_MB=4

# false にするとデモ用ツール（DEMOパネル、データ初期化、広告ネットワークのシミュレーター等）を無効化
DEMO_TOOLS_ENABLED=true

# データの共有方法: auto（既定。Vercel では Runtime Cache で全インスタンスに共有、それ以外はメモリのみ）
#                    memory | vercel | file（同じマシンの複数プロセスで共有。保存先は POIGACHA_STATE_DIR）
POIGACHA_STATE_STORE=auto
